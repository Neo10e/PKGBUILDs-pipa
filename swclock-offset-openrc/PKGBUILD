# Maintainer: Jakko <jahau@rocketmail.com>

pkgname=swclock-offset-openrc
pkgver=0.3.0
pkgrel=2
pkgdesc="Activate swclock-offset using openrc"
arch=('any')
url="https://gitlab.postmarketos.org/postmarketOS/swclock-offset"
license=('GPL-3.0-or-later')
groups=('openrc-pipa-armtix')
depends=('swclock-offset' 'openrc')
_pkgname=swclock-offset
install="$pkgname.install"
source=("https://gitlab.postmarketos.org/postmarketOS/$_pkgname/-/archive/$pkgver/$_pkgname-$pkgver.tar.gz")
sha512sums=('7779deaf688dd25b9abe8161c8a0651d11b1a44785ff4495a1c4a8b9ba2108a9e73c47cbdb3f8669c4e2e85bea884145f66311c9ce674c1464538695a9852dc0')

package() {
	cd "$srcdir/$_pkgname-$pkgver"

	sed -e 's+SWCLOCK_PATH+/usr/bin+g' openrc/$_pkgname-boot.initd.in > openrc/$_pkgname-boot.initd
	sed -e 's+SWCLOCK_PATH+/usr/bin+g' openrc/$_pkgname-shutdown.initd.in > openrc/$_pkgname-shutdown.initd

	# Install openrc service
	install -Dm755 openrc/$_pkgname-boot.initd \
		"$pkgdir/etc/init.d/$_pkgname-boot"

	install -Dm755 openrc/$_pkgname-shutdown.initd  \
		"$pkgdir/etc/init.d/$_pkgname-shutdown"
}
