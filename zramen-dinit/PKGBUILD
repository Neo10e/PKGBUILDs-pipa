# Contributor: Carlos Eduardo <capezotte@artixlinux.org>
# Contributor: Nathan <ndowens@artixlinux.org>

pkgname=zramen-dinit
pkgver=20260524
pkgrel=3
pkgdesc="dinit service scripts for zramen"
arch=('any')
url="https://artixlinux.org"
license=('BSD')
groups=('dinit-pipa-armtix')
depends=('zramen' 'dinit')
conflicts=('init-zramen')
provides=('init-zramen')
_pkgname=zramen
source=(
    "$_pkgname"
    "$_pkgname.conf"
)
sha256sums=(
    '8f7cea0a21145f4c69b70d66ad9129b6f66f17c0b2ed0b0d0206b73c3525bbc2'
    '01066e894f524b538f5bbe0697a8280637a002a63362d355207697299419a246'
)

package() {
    # Install dinit service
    install -Dm644 "$srcdir/$_pkgname" "$pkgdir/etc/dinit.d/$_pkgname"

    # Add zramen related config
	install -Dm644 "$srcdir/$_pkgname.conf" "$pkgdir/etc/dinit.d/config/$_pkgname.conf"
}
