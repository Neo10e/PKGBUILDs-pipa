pkgname=iio-sensor-proxy-libssc-dinit
pkgver=3.8
pkgrel=1
pkgdesc='IIO accelerometer sensor to input device proxy (dinit scripts)'
arch=('any')
url='https://gitlab.freedesktop.org/hadess/iio-sensor-proxy/'
license=('GPL-2.0-or-later')
groups=('dinit-pipa-armtix')
depends=('iio-sensor-proxy-libssc' 'dinit')
_pkgname=iio-sensor-proxy
install="$pkgname.install"
source=("$_pkgname-libssc.dinitd")
sha512sums=('f61c59cb4b12440a72a8d8ac575f0b8021790f4925d00977235ea3c658070b0447b2cafa3a87df6a491005a634657389cb6627a2f8a8a0b5e7d36b9504a20982')

package() {
	install -Dm755 "$srcdir"/$_pkgname-libssc.dinitd "$pkgdir"/etc/dinit.d/$_pkgname-libssc
}
