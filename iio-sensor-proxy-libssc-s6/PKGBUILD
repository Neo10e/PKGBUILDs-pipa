pkgname=iio-sensor-proxy-libssc-s6
pkgver=3.8
pkgrel=3
pkgdesc='IIO accelerometer sensor to input device proxy (Runit init scripts)'
arch=('any')
url='https://gitlab.freedesktop.org/hadess/iio-sensor-proxy/'
license=('GPL-2.0-or-later')
groups=('s6-pipa-armtix')
depends=('iio-sensor-proxy-libssc' 's6-base')
_pkgname=iio-sensor-proxy
install="$pkgname.install"
source=("$_pkgname-libssc.run")
sha512sums=('859b7410698ad30a31704e1df6cdb36ca6974f46cd95d6bb0809847cd6f4b193de431d1397f3c6df5f0172fab7a61f489c56ee93ebf429b785790f43f874ca76')

package() {
    # Install s6 service
	install -Dm755 "$srcdir"/$_pkgname-libssc.run "$pkgdir/etc/s6/sv/$_pkgname-libssc/run"

    # Add service type
    echo longrun > "$pkgdir/etc/s6/sv/$_pkgname-libssc/type"

    # Add dependency
    install -d "$pkgdir/etc/s6/sv/$_pkgname-libssc/dependencies.d"
    touch dbus "$pkgdir/etc/s6/sv/$_pkgname-libssc/dependencies.d/dbus"
    touch hexagonrpcd-sdsp "$pkgdir/etc/s6/sv/$_pkgname-libssc/dependencies.d/hexagonrpcd-sdsp"
}
