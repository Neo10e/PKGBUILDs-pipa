pkgname="hexagonrpcd-s6"
pkgdesc="Qualcomm HexagonFS daemon (s6 init scripts)"
pkgver=0.4.0
pkgrel=3
arch=('any')
url="https://gitlab.com/sdm845-mainline/hexagonrpc/"
license=(GPL-3.0-or-later)
groups=('s6-pipa-armtix')
depends=('hexagonrpcd' 's6-base')
_pkgname=hexagonrpcd
install="$pkgname.install"
source=(
    "$_pkgname-adsp-rootpd.run"
    "$_pkgname-adsp-sensorspd.run"
    "$_pkgname-sdsp.run"
)
sha512sums=(
    '9cff0eab6c7bc246ff42870e98af6345824dfd3b7ac236d5a4f28e947aac01d7a74871f0293b2e18dbd237169ad95979893c96d67a8a2cd602556f6b87dc3b0d'
    '10409d435dc4b43f19073971587f4d28ab748476482d2a759b726f390d38d1bedbed6900f7d08888b2f3f91ec9672cb365b90d6a2785c6aaceb47001cbb9261b'
    'e8033fbde69034490faa8e6d4a3295efe52ee3451bdad3c3a99b589f9255fbf839736c22a443a2e223bb1ab5a4596083346b946d3c263dd94dea4c75da7534a6'
)

package() {
    # Add Services for s6
	install -Dm755 $srcdir/$_pkgname-adsp-rootpd.run "$pkgdir/etc/s6/sv/$_pkgname-adsp-rootpd/run"
	install -Dm755 $srcdir/$_pkgname-adsp-sensorspd.run "$pkgdir/etc/s6/sv/$_pkgname-adsp-sensorspd/run"
	install -Dm755 $srcdir/$_pkgname-sdsp.run "$pkgdir/etc/s6/sv/$_pkgname-sdsp/run"

    # Add service type
    echo longrun > "$pkgdir/etc/s6/sv/$_pkgname-adsp-rootpd/type"
    echo longrun > "$pkgdir/etc/s6/sv/$_pkgname-adsp-sensorspd/type"
    echo longrun > "$pkgdir/etc/s6/sv/$_pkgname-sdsp/type"
}
