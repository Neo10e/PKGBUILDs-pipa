package() {
    # Add Services for s6
	install -Dm755 $srcdir/$_pkgname-adsp-rootpd__run "$pkgdir/etc/s6/sv/$_pkgname-adsp-rootpd/run"
	install -Dm755 $srcdir/$_pkgname-adsp-sensorspd__run "$pkgdir/etc/s6/sv/$_pkgname-adsp-sensorspd/run"
	install -Dm755 $srcdir/$_pkgname-sdsp__run "$pkgdir/etc/s6/sv/$_pkgname-sdsp/run"

