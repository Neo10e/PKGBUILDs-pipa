pkgname=device-xiaomi-pipa
pkgdesc="Package containing configurations for Xiaomi Pad 6"
pkgver=4
pkgrel=0
url="https://postmarketos.org"
license=('MIT')
arch=('aarch64')
depends=(
	'bootmac'
	'hexagonrpcd'
	'pipa-kernel-hooks'
	'linux'
	'mesa'
	'mkbootimg'
	'qbootctl'
	'iio-sensor-proxy'
	'swclock-offset'
)
source=(
	'81-libssc-xiaomi-pipa.rules'
	'xiaomi-pipa.conf'
	'hifi.conf'
	'wireplumber.conf'
	'HDMI_pipa.conf'
)
sha512sums=(
	'2c16ba75e0077b2b1eaefa4c73b287475505a1aeb291ec29316d41cc094277320f9d2aaabfd91eb1dc0f488ab2d61a94faef16e7afe0f1e226779113761b9a37'
	'b113a703930e23bbd2f7b305eabca44ed21a3d8820f83a62b378a4ac50c89f8b834c15d09b4f4a4dae34b7ef2299108fe163271a197268aa73cb72bf0df88e5e'
	'afdaf3490c7dc8300e0bfbcf156379a8043df48cf3bc2401340d9ae2455d9e2a3e150815535e72ed5338aab124dbf3ae2844cf0fad8104f3549a1d69f400a10c'
	'f4d4b5394fda2a7aaa497971e562fa0470a291ce8e475b951c5e388f7abed08f7ceebe6836e1d30764103e2eaca467b43c42c18b95ef337c40b13bbb3bfe6292'
	'fea0852f0f2ab86b9a25b496edd279878a796e1ac2d3964fa684f06c22e392e35ddd33aff9cea919c72037c4987a266f94508281734b4df2875c3884d273d8d3'
)

package() {
	# Install udev rules
	install -Dm644 "${srcdir}/81-libssc-xiaomi-pipa.rules" "${pkgdir}/usr/lib/udev/rules.d/81-libssc-xiaomi-pipa.rules"
		
	# Install ALSA UCM configuration for Xiaomi Pad 6
	# /usr/share/alsa/ucm2/conf.d/sm8250/Xiaomi Pad 6.conf  
	mkdir -p "${pkgdir} /usr/share/alsa/ucm2/conf.d/sm8250/"
	install -Dm644 "${srcdir}/xiaomi-pipa.conf" "${pkgdir}/usr/share/alsa/ucm2/conf.d/sm8250/Xiaomi Pad 6.conf"

	# /usr/share/alsa/ucm2/Qualcomm/sm8250/HiFi_pipa.conf
	mkdir -p "${pkgdir}/usr/share/alsa/ucm2/Qualcomm/sm8250/"
	install -Dm644 "${srcdir}/hifi.conf" "${pkgdir}/usr/share/alsa/ucm2/Qualcomm/sm8250/HiFi_pipa.conf"

	# /usr/share/alsa/ucm2/Qualcomm/sm8250/HDMI_pipa.conf
	install -Dm644 "${srcdir}/HDMI_pipa.conf" "${pkgdir}/usr/share/alsa/ucm2/Qualcomm/sm8250/HDMI_pipa.conf"

	# /usr/share/alsa/ucm2/conf.d/sm8250/Xiaomi-Pad6-pipa-M82.conf
	ln -s "${pkgdir}/usr/share/alsa/ucm2/conf.d/sm8250/Xiaomi Pad 6.conf" "${pkgdir}/usr/share/alsa/ucm2/conf.d/sm8250/Xiaomi-Pad6-pipa-M82.conf"

	# /usr/share/wireplumber.conf.d/51-pipa.conf
	mkdir -p "${pkgdir}/usr/share/wireplumber/wireplumber.conf.d"
	install -Dm644 "${srcdir}/wireplumber.conf" "${pkgdir}/usr/share/wireplumber/wireplumber.conf.d/51-pipa.conf"	
}


