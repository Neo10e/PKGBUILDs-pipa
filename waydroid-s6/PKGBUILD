pkgname="waydroid-s6"
pkgdesc="Waydroid Container Manager as a s6 service"
pkgver=1.6.2
pkgrel=1
arch=('any')
url="https://github.com/waydroid/waydroid"
license=('GPL-3.0-or-later')
groups=('s6-pipa-armtix')
depends=('waydroid' 's6')
_pkgname=waydroid
source=(
	"$_pkgname-container.run"
	"$_pkgname-container.finish"
)
sha512sums=(
	'1b32079abf5afdccc9db4e96b62a2c582431d08d72fd9d8df0cc0c1c61f1ee9251237d9af5dfb1daef2c9e8683d7cb1f30ddaec465a5dcef42cf2fc9bc157fd2'
	'd8f0318f1b03756a1a04d5f7657084884d3872a0e18f4786748e8e42a3811abbe3ef6ccd0a7bdbc8bbb034d7f343b4fcce50396797df10e1292f1cfd7deb44d6'
)

package() {
	# Install s6 service
	install -Dm755 "$srcdir/$_pkgname-container.run" "$pkgdir/etc/s6/sv/$_pkgname-container/run"
	install -Dm755 "$srcdir/$_pkgname-container.finish" "$pkgdir/etc/s6/sv/$_pkgname-container/finish"

    # Add service type
    echo longrun > "$pkgdir/etc/s6/sv/$_pkgname-container/type"
}
