#!/bin/sh

post_install() {
    # remove hwclock service
    /usr/lib/rc/sv.d/hwclock stop

    # assign swclock-offset services
    ln -s /etc/rc/sysinit/14-swclock-offset-boot /usr/lib/rc/sv.d/swclock-offset-boot
	ln -s /etc/rc/shutdown/34-swclock-offset-shutdown /usr/lib/rc/sv.d/swclock-offset-shutdown
    /usr/lib/rc/sv.d/swclock-offset-boot start
    /usr/lib/rc/sv.d/swclock-offset-shutdown start
}

pre_remove() {
    # Restore the original state

    # remove swclock-offset services
    /usr/lib/rc/sv.d/swclock-offset-boot stop
    /usr/lib/rc/sv.d/swclock-offset-shutdown stop
    unlink /usr/lib/rc/sv.d/swclock-offset-boot
	unlink /usr/lib/rc/sv.d/swclock-offset-shutdown

    # assign hwclock service
    /usr/lib/rc/sv.d/hwclock start
}
