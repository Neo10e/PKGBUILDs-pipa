pkgname=swclock-offset-runit
pkgver=0.3.0
pkgrel=2
pkgdesc="Activate swclock-offset using runit"
arch=('any')
url="https://gitlab.postmarketos.org/postmarketOS/swclock-offset"
license=('GPL-3.0-or-later')
groups=('runit-pipa-armtix')
depends=('swclock-offset' 'runit')
_pkgname=swclock-offset
install="$pkgname.install"
source=(
    "$_pkgname-boot.rc.in"
    "$_pkgname-shutdown.rc.in"
)
sha512sums=(
    'd790548cc2b8c93960c4774ff628b8301e6fbbc3d6dd579336722a15112b2e2d0f2489c91203905e7d3d544c26ee3bfabb34c9319853e881b442e5cf29e605c6'
    'd790548cc2b8c93960c4774ff628b8301e6fbbc3d6dd579336722a15112b2e2d0f2489c91203905e7d3d544c26ee3bfabb34c9319853e881b442e5cf29e605c6'
)

package() {
	sed -e 's+SWCLOCK_PATH+/usr/bin+g' $srcdir/$_pkgname-boot.rc.in > $srcdir/$_pkgname-boot.rc
	sed -e 's+SWCLOCK_PATH+/usr/bin+g' $srcdir/$_pkgname-shutdown.rc.in > $srcdir/$_pkgname-shutdown.rc

	# Install runit rc files
	install -Dm755 $srcdir/$_pkgname-boot.rc \
		"$pkgdir/etc/rc/sysinit/14-$_pkgname-boot"

	install -Dm755 $srcdir/$_pkgname-shutdown.rc \
		"$pkgdir/etc/rc/shutdown/34-$_pkgname-shutdown"

	ln -s "$pkgdir/etc/rc/sysinit/14-$_pkgname-boot" "$pkgdir/usr/lib/rc/sv.d/$_pkgname-boot"
	ln -s "$pkgdir/etc/rc/shutdown/34-$_pkgname-shutdown" "$pkgdir/usr/lib/rc/sv.d/$_pkgname-shutdown" 
}
