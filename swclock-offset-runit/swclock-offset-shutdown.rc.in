#!/bin/bash

# sourcing our current rc.conf requires this to be a bash script
. /usr/lib/rc/functions

case "$1" in
    start)
        stat_busy "Saving swclock-offset"
        SWCLOCK_PATH/swclock-offset-shutdown || stat_die swclock-offset-shutdown
        add_daemon swclock-offset-shutdown
        stat_done
        ;;
    stop)
        stat_busy "Suspending swclock-offset"
        SWCLOCK_PATH/swclock-offset-shutdown || stat_die swclock-offset-shutdown
        rm_daemon swclock-offset-shutdown
        stat_done
        ;;
    *)
        echo "usage: $0 {start|stop}"
        exit 1
        ;;
esac
