pkgname="hexagonrpcd-dinit"
pkgdesc="Qualcomm HexagonFS daemon (dinit scripts)"
pkgver=0.4.0
pkgrel=2
arch=('any')
url="https://gitlab.com/sdm845-mainline/hexagonrpc/"
license=(GPL-3.0-or-later)
groups=('dinit-pipa-armtix')
depends=('hexagonrpcd' 'dinit')
_pkgname=hexagonrpcd
install="$pkgname.install"
source=(
    "$_pkgname-adsp-rootpd.dinitd"
    "$_pkgname-adsp-sensorspd.dinitd"
    "$_pkgname-sdsp.dinitd"
)
sha512sums=(
    '352197e71668f3a1d51ddd2e3b38792590ebe815359c75dbea0c5755c2c8b6287e38cc7cb4bc80ad0fa2d0dcb0c30d3e0dd86d0d4799d65906c383cb8904dabe'
    '17854764baaf072099bdeeef6e192231a0851ab987720c80a53b8e9cc7368337f5fdb7803063e398c33d4e6828383d2e428319105f3f6e64da4132719c3f7544'
    '0fd5fc804468569ddc6fe888f6aaf64f2fd58f3aa87d8d64f0ad339471a4e5d7031584b402ef3bc7dba3fd62e903e31dfd9f35ebc8a9660e83e691081988c8df'
)

package() {
    # Add Services for dinit
	install -Dm755 $srcdir/$_pkgname-adsp-rootpd.dinitd "$pkgdir/etc/dinit.d/$_pkgname-adsp-rootpd"
	install -Dm755 $srcdir/$_pkgname-adsp-sensorspd.dinitd "$pkgdir/etc/dinit.d/$_pkgname-adsp-sensorspd"
	install -Dm755 $srcdir/$_pkgname-sdsp.dinitd "$pkgdir/etc/dinit.d/$_pkgname-sdsp"
}
