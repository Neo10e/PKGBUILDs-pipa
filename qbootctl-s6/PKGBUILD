pkgname="qbootctl-s6"
pkgdesc="Mark current boot as successful in Android A/B interface"
pkgver=0.2.2
pkgrel=2
arch=('any')
url="https://github.com/linux-msm/qbootctl"
license=('GPL-3.0-or-later')
groups=('s6-pipa-armtix')
depends=('qbootctl' 's6-base')
_pkgname=qbootctl
install="$pkgname.install"
source=("$_pkgname.up")
sha512sums=('704c85c52e4e069458b2d16714a026c4a146eeaa3ceb8dfc88e4fa787d8868d480e3fb245747d1a4ea04901eabd6e6fe2a1bd7273c212ab971820a84b86267d0')

package() {
	# Install s6 service
	install -Dm755 "$srcdir/$_pkgname.up" "$pkgdir/etc/s6/sv/$_pkgname/up"

    # Add service type
    echo oneshot > "$pkgdir/etc/s6/sv/$_pkgname/type"
}
