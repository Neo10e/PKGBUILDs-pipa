pkgname=device-xiaomi-pipa-s6
pkgdesc="Package containing skarnet's s6 configurations for Xiaomi Pad 6"
pkgver=4
pkgrel=1
url="https://postmarketos.org"
license=('MIT')
arch=('aarch64')
groups=('s6-pipa-armtix')
depends=(
	'device-xiaomi-pipa'
	'hexagonrpcd-s6'
	'qbootctl-s6'
	'iio-sensor-proxy-libssc-s6'
	'swclock-offset-s6'
	's6-base'
)
source=(
	'hexagonrpcd.conf'
	'sensor-fix.sh'
)
sha512sums=(
	'7db4a5c9f9b9b03ec0448d1999fa990fc2b1d9f0245801539c53e3d0265c04cf4b91166385930f43fee5fc99cbaf70c90d564f5be3e7950caebf9974f3869144'
	'a4649bcf654de34708afa36d8f1c3d9b7b319ab050aac7bcbeb3178084fc175bd43b16f3e8c6cc085f0077eee40cd855818a903ca7a75f7c77f8ff6b407f1801'
)

package() {
	# Add hexagonrpcd related configs
	install -Dm644 "$srcdir"/hexagonrpcd.conf "$pkgdir"/etc/s6/config/hexagonrpcd-sdsp.conf
	install -Dm644 "$srcdir"/hexagonrpcd.conf "$pkgdir"/etc/s6/config/hexagonrpcd-adsp-rootpd.conf
	install -Dm644 "$srcdir"/hexagonrpcd.conf "$pkgdir"/etc/s6/config/hexagonrpcd-adsp-sensorspd.conf

	# Fix sensor suspend issue
	install -Dm755 "${srcdir}/sensor-fix.sh" "${pkgdir}/usr/lib/elogind/system-sleep/sensor-fix.sh"
}


